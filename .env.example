# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- AL MAMOURA FESTIVAL PRODUCTION CONFIGURATION ---

# SUPABASE: Database & User Authentication
# For Coolify / Docker deployment, configure these in Coolify's Environment Variables panel:
SUPABASE_URL="https://cbksbxmzeqefbdqzbprn.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
VITE_SUPABASE_URL="https://cbksbxmzeqefbdqzbprn.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# ZIINA PAYMENT GATEWAY (UAE):
# Obtain your production or test API key from https://business.ziina.com
ZIINA_API_KEY="your_ziina_api_key_or_bearer_token"
ZIINA_WEBHOOK_SECRET="your_ziina_webhook_secret"
ZIINA_TEST_MODE="true"
PORT="3000"

